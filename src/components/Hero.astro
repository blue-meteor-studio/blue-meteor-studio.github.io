---
// The top of the page: the studio's name in a night sky, standing over the horizon of an arena floor.
// A thin trail of light comes down from the upper left and ends on the "O" of the name: the meteor.
// Everything drawn here is decoration (aria-hidden); the words are the content.
import Wordmark from "./Wordmark.astro";
import { games } from "../data/games";
import { toLocale, useTranslations } from "../i18n";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

// The stars are placed by a seeded generator, so every build draws the same sky.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let n = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    n = (n + Math.imul(n ^ (n >>> 7), 61 | n)) ^ n;
    return ((n ^ (n >>> 14)) >>> 0) / 4294967296;
  };
}
const random = mulberry32(20261124);
const stars = Array.from({ length: 120 }, () => {
  const size = random();
  return {
    x: Math.round(random() * 16000) / 10,
    y: Math.round(random() ** 1.35 * 9000) / 10, // more of them high in the sky
    r: size > 0.93 ? 1.9 : size > 0.7 ? 1.3 : 0.8,
    o: Math.round((0.35 + random() * 0.6) * 100) / 100,
    twinkle: random() < 0.34 ? 1 + Math.floor(random() * 3) : 0,
  };
});
---

<section class="hero" id="top">
  <div class="hero__art" aria-hidden="true">
    <svg class="hero__stars" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
      {
        stars.map((star) => (
          <circle
            class={star.twinkle ? `tw tw${star.twinkle}` : undefined}
            cx={star.x}
            cy={star.y}
            r={star.r}
            fill="#c9d6ff"
            opacity={star.o}
          />
        ))
      }
    </svg>

    <span class="hero__streak hero__streak--a"></span>
    <span class="hero__streak hero__streak--b"></span>
    <span class="hero__streak hero__streak--c"></span>
  </div>

  <div class="hero__sky container">
    <h1 class="hero__title">
      <Wordmark />
      <span class="hero__trail" aria-hidden="true"><span></span></span>
    </h1>
  </div>

  <div class="hero__ground">
    <div class="hero__floor" aria-hidden="true">
      <div class="hero__grid"></div>
    </div>
    <div class="hero__content container">
      <p class="hero__lead">{t.hero.lead}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#games">{t.hero.cta}</a>
      </div>
      <p class="hero__now">
        <span class="chip">{t.hero.nowLabel}</span>
        <span class="hero__now-list" lang="en">
          {games.map((game) => <a href={`#${game.id}`}>{game.title}</a>)}
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  /* Two parts, one above the other: the sky, which takes the room that is left and holds the name,
     and the ground, which is as tall as its words need. The horizon is the line between them. */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: clamp(34rem, 100svh, 60rem);
    /* The sky runs up behind the header. */
    margin-top: calc(var(--header-h) * -1);
    padding-top: var(--header-h);
    overflow: clip;
    background:
      radial-gradient(90% 70% at 24% 6%, rgb(29 78 216 / 0.2), transparent 62%),
      linear-gradient(180deg, #060815 0%, var(--void) 55%, #0b1030 100%);
  }

  .hero__art {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: clip;
  }

  .hero__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tw {
    animation: twinkle 4.6s ease-in-out infinite;
  }

  .tw2 {
    animation-duration: 6.2s;
    animation-delay: -2.1s;
  }

  .tw3 {
    animation-duration: 7.8s;
    animation-delay: -4.4s;
  }

  @keyframes twinkle {
    50% {
      opacity: 0.12;
    }
  }

  /* Thin streaks cross the sky now and then, the way the meteor came: down to the right. */
  .hero__streak {
    position: absolute;
    width: 8rem;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--frost));
    opacity: 0;
    rotate: 45deg;
    animation: streak 13s linear infinite;
  }

  .hero__streak--a {
    left: 18%;
    top: 12%;
    animation-delay: 4s;
  }

  .hero__streak--b {
    left: 66%;
    top: 8%;
    width: 5.5rem;
    animation-delay: 8.5s;
  }

  .hero__streak--c {
    left: 84%;
    top: 30%;
    width: 6.5rem;
    animation-delay: 12s;
  }

  @keyframes streak {
    0% {
      opacity: 0;
      translate: -6rem -6rem;
    }
    1.5% {
      opacity: 0.85;
    }
    7% {
      opacity: 0;
      translate: 9rem 9rem;
    }
    100% {
      opacity: 0;
      translate: 9rem 9rem;
    }
  }

  .hero__sky {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* The name stands just above the horizon, with the whole sky over it. */
    justify-content: flex-end;
    padding-bottom: clamp(2rem, 5.5svh, 3.75rem);
    /* The trail fades out towards the top of the sky, whatever the window's height: it does not end
       at the header's edge. The space above the name is at least as tall as the fade, so the name
       itself is never faded. */
    padding-top: 7rem;
    mask-image: linear-gradient(180deg, transparent 0.5rem, #000 6.5rem);
    -webkit-mask-image: linear-gradient(180deg, transparent 0.5rem, #000 6.5rem);
  }

  /* The studio's wordmark. It is about 9.3 times as wide as its font-size: as large as the page's
     width allows, up to a limit that grows a little with the window. */
  .hero__title {
    position: relative;
    display: flex;
    font-size: clamp(1.75rem, min(calc((100vw - 2 * var(--gutter)) / 9.4), max(4.5rem, 5.6vw)), 7.5rem);
    line-height: 1;
    text-shadow: 0 0.04em 0.5em rgb(8 10 24 / 0.6);
  }

  /* The meteor's trail: a thin wedge of light that comes down at 45 degrees and ends on the upper
     left edge of the ring that is the "O" of the name. That point is 7.745em from the left of the
     wordmark and 0.236em from its top (the ring's centre is at 8.003em, 0.494em; its radius is 0.365em).
     The outer box is turned about that point; the inner one is the light itself. */
  .hero__trail {
    position: absolute;
    left: calc(7.745em - var(--trail));
    top: calc(0.236em - var(--trail-w) / 2);
    width: var(--trail);
    height: var(--trail-w);
    transform-origin: 100% 50%;
    rotate: 45deg;
    pointer-events: none;
    --trail: max(11em, 22rem);
    --trail-w: max(2px, 0.034em);
  }

  .hero__trail span {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgb(91 140 255 / 0) 0%,
      rgb(91 140 255 / 0) 22%,
      rgb(91 140 255 / 0.5) 80%,
      rgb(201 214 255 / 0.9) 96%,
      rgb(233 251 246 / 0.95) 100%
    );
    /* A point at the far end, full width where it meets the ring. */
    clip-path: polygon(0 50%, 100% 0, 100% 100%);
    transform-origin: 0 50%;
  }

  /* On arrival the trail is drawn from the sky down to the ring, and then the air in front of the ring lights up.
     (Animation names are shared by the whole page: these two are named for the trail so that they meet no other.) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__trail span {
      animation: trail-fall 1.1s cubic-bezier(0.3, 0, 0.2, 1) 0.25s both;
    }

    .hero__title :global(.wordmark__o path) {
      animation: trail-light 0.7s ease-out 1.15s both;
    }
  }

  @keyframes trail-fall {
    from {
      scale: 0 1;
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
  }

  @keyframes trail-light {
    from {
      opacity: 0;
    }
  }

  .hero__ground {
    position: relative;
    isolation: isolate;
    padding-top: clamp(2rem, 5svh, 3.25rem);
    padding-bottom: clamp(2.5rem, 8svh, 5.5rem);
  }

  /* The horizon. */
  .hero__ground::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(111 211 255 / 0.55) 30%, rgb(111 211 255 / 0.55) 70%, transparent);
    box-shadow: 0 0 2.5rem 0.6rem rgb(91 140 255 / 0.22);
  }

  /* Darkens the floor under the words and where the next section begins. */
  .hero__ground::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 90% at 50% 48%, rgb(8 10 24 / 0.6), transparent 72%),
      linear-gradient(0deg, rgb(8 10 24 / 0.7) 0%, transparent 45%);
  }

  /* The arena floor: a lit grid that runs to the horizon. */
  .hero__floor {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: clip;
    perspective: 26rem;
    perspective-origin: 50% 0%;
    mask-image: linear-gradient(180deg, transparent 0%, #000 34%, #000 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 34%, #000 100%);
  }

  .hero__grid {
    position: absolute;
    top: 0;
    left: -75%;
    width: 250%;
    height: 420%;
    transform-origin: 50% 0%;
    transform: rotateX(74deg);
    background-image:
      linear-gradient(90deg, rgb(91 140 255 / 0.55) 2px, transparent 2px),
      linear-gradient(180deg, rgb(91 140 255 / 0.55) 2px, transparent 2px);
    background-size: 5.5rem 5.5rem;
    background-position: 50% 0;
    animation: floor 4s linear infinite;
  }

  @keyframes floor {
    to {
      background-position: 50% 5.5rem;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__lead {
    color: var(--text);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  .hero__now {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 0.9rem;
    margin-top: clamp(1.75rem, 4.5svh, 3rem);
  }

  .hero__now-list {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 1.4rem;
    color: var(--text-soft);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__now-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  /* Every name has its own mark, so none is left hanging where the line breaks. */
  .hero__now-list a::before {
    content: "";
    flex: none;
    width: 0.4em;
    height: 0.4em;
    background: var(--azure);
  }

  .hero__now-list a:hover {
    color: var(--text);
    text-decoration: underline;
  }
</style>
