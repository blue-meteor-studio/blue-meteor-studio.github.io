---
// A game there is nothing to show of yet: its name, that it is being made, and a drawing of falling lights.
import type { Game } from "../data/games";
import { toLocale, useTranslations } from "../i18n";

interface Props {
  game: Game;
}

const { game } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Nine lights, falling the way the studio's meteor falls.
const streaks = [
  { x: 6, y: 18, length: 30, delay: 0.0 },
  { x: 17, y: 58, length: 22, delay: 1.7 },
  { x: 29, y: 8, length: 38, delay: 0.6 },
  { x: 40, y: 44, length: 26, delay: 2.4 },
  { x: 52, y: 22, length: 34, delay: 1.1 },
  { x: 63, y: 62, length: 20, delay: 3.0 },
  { x: 74, y: 12, length: 40, delay: 0.3 },
  { x: 85, y: 48, length: 28, delay: 2.0 },
  { x: 95, y: 26, length: 32, delay: 1.4 },
];
---

<article class="teaser reveal" id={game.id}>
  <div class="teaser__art" aria-hidden="true">
    {
      streaks.map((streak) => (
        <span
          class="teaser__streak"
          style={`left:${streak.x}%;top:${streak.y}%;width:${streak.length}%;animation-delay:-${streak.delay}s`}
        />
      ))
    }
  </div>
  <div class="teaser__body">
    <p class="chip">{t.games.status}</p>
    <h3 class="teaser__title display" lang="en">
      {
        game.titleWords.map((word, index) => (
          <>
            {index > 0 && " "}
            <span class:list={{ accent: word.accent }}>{word.text}</span>
          </>
        ))
      }
    </h3>
    <p class="teaser__summary">{game.summary[locale]}</p>
  </div>
</article>

<style>
  .teaser {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(70% 120% at 100% 0%, rgb(29 78 216 / 0.28), transparent 60%),
      var(--midnight);
  }

  .teaser__art {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.35) 38%, #000 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.35) 38%, #000 100%);
  }

  .teaser__streak {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, var(--frost), rgb(91 140 255 / 0.5) 30%, transparent);
    transform-origin: 0 50%;
    rotate: -32.5deg;
    animation: fall 4.2s ease-in-out infinite alternate;
  }

  /* Each light has a bright head at its lower end. */
  .teaser__streak::before {
    content: "";
    position: absolute;
    left: -3px;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--core);
    box-shadow: 0 0 12px 3px rgb(111 211 255 / 0.7);
  }

  @keyframes fall {
    from {
      translate: 1.1rem -0.7rem;
      opacity: 0.5;
    }
    to {
      translate: -1.1rem 0.7rem;
      opacity: 1;
    }
  }

  .teaser__title {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 7.5vw, 4rem);
    line-height: 0.9;
  }

  .teaser__summary {
    max-width: 30em;
    margin-top: 1rem;
  }
</style>
