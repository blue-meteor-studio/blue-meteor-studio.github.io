---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitch from "./LanguageSwitch.astro";
import Logo from "./Logo.astro";
import Wordmark from "./Wordmark.astro";
import { toLocale, useTranslations } from "../i18n";

interface Props {
  /** The page's path inside a language, for the language switch. */
  path?: string;
}

const { path = "" } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, "");
---

<header class="header">
  <div class="header__inner container">
    <a class="brand" href={`${home}#top`} aria-label={t.a11y.home}>
      <Logo size={30} class="brand__mark" />
      <Wordmark class="brand__name" />
    </a>
    <nav class="nav" aria-label={t.a11y.mainNav}>
      <a class="nav__link" href={`${home}#about`}>{t.nav.about}</a>
      <a class="nav__link" href={`${home}#games`}>{t.nav.games}</a>
    </nav>
    <LanguageSwitch path={path} />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    /* Nearly solid: where the blur behind is not drawn, the page must not show through the links. */
    background: rgb(8 10 24 / 0.92);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2rem);
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: var(--text);
    text-decoration: none;
  }

  /* The name carries the logo as its "O", so the logo on its own is shown only where the name is not (narrow phones, below). */
  .brand :global(.brand__mark) {
    display: none;
    flex: none;
  }

  /* The wordmark is as large as this. */
  .brand :global(.brand__name) {
    font-size: 1.375rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 2vw, 1.25rem);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    color: var(--text-soft);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav__link:hover {
    color: var(--text);
  }

  /* On a narrow phone the logo stands alone: the name is in the hero just below. */
  @media (max-width: 30rem) {
    /* Pulled back by the margin inside the symbol's frame, so that the ring's edge lines up with the page's. */
    .brand :global(.brand__mark) {
      display: block;
      margin-left: -2.5px;
    }

    .brand :global(.brand__name) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
