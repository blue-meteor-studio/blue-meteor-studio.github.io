---
// The studio's logo: a ring (the meteor, falling to the lower right) and a crescent of blue light
// where it pushes the air aside. One drawing, framed in two ways:
//   "symbol": the whole drawing in a square with a margin, to stand on its own.
//   "letter": the ring fills the box, to stand among letters as the "O" of the name; the crescent
//             hangs outside the box, so the box is not clipped. Its size is set in CSS, in em.
// The ring takes the colour of the text around it; the light is always the brand's blue.
import { logoColors, logoFrames, logoShapes } from "./logo-shapes";

interface Props {
  frame?: keyof typeof logoFrames;
  /** Width and height in pixels. A symbol is 32 unless told otherwise; a letter has no size of its own. */
  size?: number;
  class?: string;
}

const { frame = "symbol", size, class: className } = Astro.props;
const pixels = size ?? (frame === "symbol" ? 32 : undefined);
const { ring } = logoShapes;
---

<svg
  class={className}
  width={pixels}
  height={pixels}
  viewBox={logoFrames[frame]}
  style={frame === "letter" ? "overflow: visible" : undefined}
  aria-hidden="true"
  focusable="false"
  ><circle cx={ring.cx} cy={ring.cy} r={ring.r} fill="none" stroke="currentColor" stroke-width={ring.width}></circle><path
    d={logoShapes.light}
    fill={logoColors.light}></path></svg
>
