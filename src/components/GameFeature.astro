---
// The game the site leads with: its pictures, what it is, where to play it.
import FeatureIcon from "./FeatureIcon.astro";
import Gallery from "./Gallery.astro";
import type { Game } from "../data/games";
import { toLocale, useTranslations } from "../i18n";

interface Props {
  game: Game;
}

const { game } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const shots = game.shots?.[locale] ?? [];
const features = game.features?.[locale] ?? [];
const platforms = game.platforms ?? [];
---

<article class="game reveal" id={game.id}>
  <header class="game__head">
    <p class="chip">{t.games.status}</p>
    <h3 class="game__title display" lang="en">
      {
        game.titleWords.map((word, index) => (
          <>
            {index > 0 && " "}
            <span class:list={{ accent: word.accent }}>{word.text}</span>
          </>
        ))
      }
    </h3>
    {game.tagline && <p class="game__tagline">{game.tagline[locale]}</p>}
  </header>

  {
    shots.length > 0 && (
      <div class="game__media">
        <Gallery shots={shots} note={game.shotsNote?.[locale]} />
      </div>
    )
  }

  <div class="game__body">
    <p class="game__summary">{game.summary[locale]}</p>
    {
      game.playUrl && (
        <div class="game__actions">
          <a class="button button--primary" href={game.playUrl} target="_blank" rel="noopener">
            {t.games.play}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
              <path d="M5 3h8v8M13 3 3 13" />
            </svg>
            <span class="sr-only">({t.a11y.newTab})</span>
          </a>
        </div>
      )
    }
    {
      platforms.length > 0 && (
        <div class="game__platforms">
          <p class="label">{t.games.platforms}</p>
          <ul>
            {platforms.map((platform) => (
              <li class:list={["platform", `platform--${platform.state}`]}>
                <span class="platform__name">{platform.name}</span>
                <span class="platform__state">
                  {platform.state === "live" ? t.games.platformLive : t.games.platformPlanned}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  {
    features.length > 0 && (
      <ul class="game__features">
        {features.map((feature) => (
          <li class="feature">
            <FeatureIcon name={feature.icon} />
            <h4 class="feature__title">{feature.title}</h4>
            <p class="feature__body">{feature.body}</p>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .game {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
    grid-template-areas:
      "head"
      "media"
      "body"
      "features";
  }

  .game__head {
    grid-area: head;
  }

  .game__media {
    grid-area: media;
    min-width: 0;
  }

  .game__body {
    grid-area: body;
  }

  .game__features {
    grid-area: features;
  }

  .game__title {
    margin-top: 1rem;
    font-size: clamp(2.75rem, 8.5vw, 4.5rem);
    line-height: 0.88;
  }

  .game__tagline {
    margin-top: 0.9rem;
    color: var(--text);
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .game__summary {
    max-width: 34em;
  }

  .game__actions {
    margin-top: 1.75rem;
    /* Room for the button's frame. */
    padding-left: 6px;
  }

  .game__platforms {
    margin-top: 2rem;
  }

  .game__platforms ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .platform {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line-strong);
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .platform__name {
    color: var(--text);
    font-weight: 700;
  }

  .platform__state {
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .platform--live {
    border-color: rgb(53 230 196 / 0.5);
  }

  .platform--live .platform__state {
    color: var(--mint);
  }

  .game__features {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    background: var(--line);
    border: 1px solid var(--line);
  }

  .feature {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background: var(--bg);
  }

  .feature :global(.feature-icon) {
    color: var(--azure);
  }

  .feature__title {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .feature__body {
    margin-top: 0.4rem;
    color: var(--text-dim);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Wide: the pictures on the left, the words beside them. */
  @media (min-width: 64rem) {
    .game {
      grid-template-columns: minmax(0, 46rem) minmax(0, 1fr);
      grid-template-areas:
        "media head"
        "media body"
        "features features";
      column-gap: clamp(2rem, 4vw, 3.5rem);
      row-gap: 1.5rem;
    }

    .game__head {
      align-self: end;
    }

    .game__features {
      margin-top: clamp(1rem, 2vw, 2rem);
    }
  }
</style>
